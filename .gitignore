# Debug & npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data & logs
*.log
logs/
pids/
*.pid
*.seed
*.pid.lock
tmp/
temp/

