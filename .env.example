# Postgres that n8n ALSO uses (the "Postgres account" credential). Schema `att` lives here.
DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_SSL=false
SESSION_SECRET=change-me-long-random
COOKIE_SECURE=false
N8N_BASE_URL=https://n8n.webbea.qa
N8N_WEBHOOK_SECRET=same-value-as-the-x-api-secret-check-in-the-n8n-workflows
# First admin, created by db-setup (optional, min 8 chars)
ADMIN_NAME=Principal
ADMIN_EMAIL=
ADMIN_PASSWORD=
