# ---- SchoolDB (separate Postgres container, created by docker compose) ----
# Use letters and numbers only for the password (e.g. run: openssl rand -hex 16)
SCHOOLDB_USER=schooladmin
SCHOOLDB_PASSWORD=
SCHOOLDB_NAME=schooldb
SCHOOLDB_PORT=5433
# Leave DATABASE_URL commented to use the bundled SchoolDB. Set it only to use some other Postgres.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

SESSION_SECRET=change-me-long-random
COOKIE_SECURE=false
N8N_BASE_URL=https://n8n.webbea.qa
N8N_WEBHOOK_SECRET=copy-the-real-secret-here

# First admin, created by db-setup (min 8 chars)
ADMIN_NAME=Principal
ADMIN_EMAIL=
ADMIN_PASSWORD=
