# ---- SchoolDB (separate Postgres container, created by docker compose) ----
# Use letters and numbers only for the password (e.g. run: openssl rand -hex 16)
SCHOOLDB_USER=schooladmin
SCHOOLDB_PASSWORD=
SCHOOLDB_NAME=schooldb
SCHOOLDB_PORT=5433
# Leave DATABASE_URL commented to use the bundled SchoolDB. Set it only to use some other Postgres.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

SESSION_SECRET=change-me-long-random
COOKIE_SECURE=false
N8N_BASE_URL=https://n8n.webbea.qa
N8N_WEBHOOK_SECRET=4331ccb0ee3e19c39902dbcb63b6dc559d0d655359a4f425

# First admin and (optional) Super Admin, created by: docker compose run --rm api-setup (min 8 chars)
ADMIN_NAME=Principal
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public https address of this dashboard. Needed so report-card PDF links can be fetched by WhatsApp, e.g. https://sa.nihalbabu.in
PUBLIC_APP_URL=

# Super Admin (multi-school owner). Leave empty if you do not need one.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# API server tuning (optional)
# DB_POOL_MAX=10
# RUN_SCHEDULER=true   # set false on extra API instances so only one runs the background jobs
